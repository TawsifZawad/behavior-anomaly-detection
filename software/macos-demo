#!/usr/bin/env bash
# Behavior Anomaly Detection System — macOS demo launcher.
#
# Runs the app from the project source. Requires Python 3 and the
# dependencies (see requirements.txt). For a true standalone binary that
# needs no Python, run ./software/build-standalone.sh ON macOS.
#
# Usage:
#   ./software/macos-demo            # interactive menu (Own / Analyze / Live)
#   ./software/macos-demo analyze    # sample-data report
#   sudo ./software/macos-demo own   # live scan of THIS machine (needs admin
#                                    # for the unified log / eslogger)
cd "$(dirname "$0")/.." || exit 1
exec python3 bads.py "$@"
